# ==============================================================================
# CRAFTNEST — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env.development, .env.qa, or .env.production as needed
# ==============================================================================
ENVIRONMENT=development  # development | qa | production
PORT=5005

# OTP & Email Settings
DEV_OTP_ENABLED=true     # true in DEV only; MUST be false in QA & production
SMTP_ENABLED=false       # false in DEV; true in QA & production
EMAIL_PROVIDER=console   # console in DEV; smtp in QA & production

# ==============================================================================
# MULTI-DATABASE ARCHITECTURE (Neon PostgreSQL)
# ==============================================================================
# DB1 - Main Owner Database (Platform governance & central registry)
# Set NEON_OWNER_DATABASE_URL (or OWNER_DATABASE_URL / DATABASE_URL)
NEON_OWNER_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
OWNER_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# DB2 - Seller A Database (First Artisan Workshop)
# Set NEON_SELLER_2_DATABASE_URL (or SELLER_DATABASE_URL_2)
NEON_SELLER_2_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SELLER_DATABASE_URL_2=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Future Seller Databases (Dynamically resolved per artisan)
# NEON_SELLER_3_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# SELLER_DATABASE_URL_3=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# NEON_SELLER_4_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# SELLER_DATABASE_URL_4=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# CORS Settings
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Secrets
JWT_SECRET=YOUR_JWT_SECRET_KEY
SECRET_KEY=YOUR_FLASK_SECRET_KEY

# SMTP Gateway Credentials (Required for QA & production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=CraftNest <your_email@gmail.com>

# Feature Flags
ENABLE_PAYMENT=false
ENABLE_SMS=false
ENABLE_OTP=true
ENABLE_EMAIL=false

LOG_LEVEL=DEBUG
UPLOAD_FOLDER=static/uploads
